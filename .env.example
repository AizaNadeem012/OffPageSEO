# ==============================================================================
# Off-Page SEO Automation Agent - Environment Configuration
# ==============================================================================
# Note: The application starts in Local Simulation & Sandbox mode by default.
# None of these keys are required to explore, run, and test the dashboard.
# Provide real keys only when switching to live external APIs.
# Never commit your actual `.env.local` or secret keys to version control.
# ==============================================================================

# Search Engine & SERP Discovery (Optional for live SERP crawling)
SERPAPI_API_KEY=your_serpapi_key_here
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# SEO Metrics & Authority Providers (Optional)
AHREFS_API_KEY=your_ahrefs_api_key_here
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# Contact Finding & Email Verification (Optional)
HUNTER_API_KEY=your_hunter_io_api_key_here
ANYMAIL_FINDER_API_KEY=your_anymail_finder_key_here

# AI Personalization & Content Synthesis (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Outbound Email SMTP Settings (For manual/approved outreach delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=outreach@yourdomain.com
SMTP_FROM_NAME="SEO Outreach Specialist"

# Safety Controls & Throttling
NEXT_PUBLIC_DEFAULT_DAILY_LIMIT=15
NEXT_PUBLIC_ENFORCE_MANUAL_APPROVAL=true
NEXT_PUBLIC_MAX_SPAM_SCORE=25
